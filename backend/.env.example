DATABASE_URL=sqlite:///./route53.db
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
DEBUG=true

# Plain URL, comma-separated, or JSON array all work (no spaces around = on Render).
# Render production example:
# BACKEND_CORS_ORIGINS=https://your-app.vercel.app
# Multiple origins:
# BACKEND_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# JSON also OK: BACKEND_CORS_ORIGINS=["https://your-app.vercel.app"]
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Plain host, comma-separated, or JSON. On Render use: ALLOWED_HOSTS=*
# ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com,your-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost,*
