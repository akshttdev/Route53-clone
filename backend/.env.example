DATABASE_URL=sqlite:///./route53.db
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
DEBUG=true

# Comma-separated. For production include your Vercel URL, e.g.:
# BACKEND_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated hosts for TrustedHostMiddleware. Use * for free PaaS demos.
# ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com,your-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost,*
